
// load the base configuration
exec default.cfg

// load the last saved configuration
exec config.cfg

// run a user script file if present
exec autoexec.cfg

alias fogcycle "fog1"
alias fog1 "fog 0.03 0.3 0.15 0.2; alias fogcycle fog2;"
alias fog2 "fog 0.02 0.33 0.33 0.5; alias fogcycle fog3;"
alias fog3 "fog 0.04 0.3 0.3 0.3; alias fogcycle fog4;"
alias fog4 "fog 0.03 0.3 0.2 0.1; alias fogcycle fog5;"
alias fog5 "fog 0.03 0.15 0.22 0.12; alias fogcycle fog6;"
alias fog6 "fog 0; alias fogcycle fog1;"

scr_printspeed 16

alias ver "impulse 140"
alias version_copper "impulse 140"
alias invoke "impulse 100"
alias reveal "impulse 101"
alias debug_trigger "impulse 102"
alias debug_ammo "impulse 103"
alias debug_flags "impulse 104"
alias exterminate "impulse 66"
alias undying "impulse 215"
alias vamp "impulse 222"
alias zerk "impulse 223"
alias suit "impulse 225"
alias pent "impulse 235"
alias invis "impulse 245"
alias ring invis
alias quad "impulse 255"
alias idkfa "impulse 9"
alias keys "impulse 99"
alias toggle_custom_crosshair "impulse 17"
alias toggle_hud "impulse 18"

alias gohome "mvr_campaign hub"

// stuff command line statements
vr_maps_fetch 0
vr_grade 0
vr_body_mode 0
r_drawviewmodel 1
bind RTRIGGER +attack
bind LTRIGGER +offhandattack
bind RSHOULDER +grabmain
bind LSHOULDER +graboff
alias mvr_mag_release ""
bind BBUTTON mvr_mag_release
bind ABUTTON +jump
bind LTHUMB +speed
// Pipe wrench: lower grip at the origin, helping hand above it, jaw vertex 180.
vr_wofs_id_30 progs/v_mvrinvoker.mdl
vr_wofs_scale_30 1
vr_wofs_x_30 0
vr_wofs_y_30 0
vr_wofs_z_30 0
vr_wofs_fgr_manual_30 1
vr_wofs_id_31 progs/v_mvrwrench.mdl
vr_wofs_scale_31 1
vr_wofs_x_31 -1
vr_wofs_y_31 0
vr_wofs_z_31 -3
vr_wofs_muzzle_av_31 180
vr_wofs_2h_mode_31 1
vr_wofs_hs1_type_31 3
vr_wofs_hs1_x_31 2.4
vr_wofs_hs1_y_31 0
vr_wofs_hs1_z_31 6
vr_wofs_w_mass_31 3.1
vr_wofs_w_com_31 23
vr_wofs_w_len_31 62
vr_wofs_id_32 progs/v_mvrmmml.mdl
vr_wofs_scale_32 1
vr_wofs_hand_av_32 172
vr_wofs_2h_hand_av_32 258
vr_wofs_2h_dispmd_32 1
vr_wofs_2h_mode_32 1
vr_wofs_id_29 progs/v_mvrgren.mdl
vr_wofs_scale_29 1
vr_wofs_hand_av_29 1
vr_wofs_2h_hand_av_29 1026
vr_wofs_2h_dispmd_29 1
vr_wofs_2h_mode_29 1
stuffcmds

sv_protocol 999

// start demos if not already running a server
//startdemos demo_c1 demo_c2 demo_c3 demo2 demo3

//map start

